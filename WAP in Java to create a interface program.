package p41;

public interface Operation 
{
	void add();
	void sub();
	void div();
}
package p41;


public abstract class DemoOperation implements Operation
{
	public void add()
	{
		int a=10,b=20;
		int c=a+b;
		System.out.println(c);
	}
}
package p41;

public class Demo2 extends DemoOperation
{	
	public void sub() 
	{
		int a=20,b=10;
		int c=a-b;
		System.out.println(c);
	}
	public void div() 
	{
		int a=30,b=15;
		int c=a/b;
		System.out.println(c);
	}
	
	public static void main(String[]args)
	{
		Demo2 d=new Demo2();
			d.add();
			d.sub();
			d.div();
	}
}

 
