package p40;
class Result{
	int marks=85;
	void display() {
		System.out.println("marks: "+marks);
	}
	
}
class Student extends Result{
	int roll=18;
	String name="nivas";
	void show() {
		System.out.println("Roll no:" +roll);
		System.out.println("Name: "+name);
	}
	public static void main(String[] args) {
		Student s=new Student();
		s.display();
		s.show();
	
	}
}
